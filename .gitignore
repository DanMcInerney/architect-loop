Thumbs.db
*.swp
__pycache__/
# Specs, frozen checks, and eval fixtures are tracked; everything else under
# docs/ is local run scratch (job reports, checkrun evidence, manifests).
# docs/STOP is the loop kill switch — never commit it.
/docs/*
!/docs/checks/
!/docs/evals/
!/docs/issues/
!/docs/spec/
!/docs/adr/
/.claude/
/.architect/
/research/
.gstack/
benchmarks/
